[Unit]
Description=Magic Mouse 2 Wayland Gestures
Documentation=https://github.com/Salacfrantisek/magic-mouse-wayland-gestures
After=graphical-session.target magic-mouse-wayland-gestures-ydotool.service
Wants=magic-mouse-wayland-gestures-ydotool.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/magic-mouse-wayland-gestures/magic_mouse_gestures.py
Environment=YDOTOOL_SOCKET=%t/magic-mouse-wayland-gestures.sock
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true

[Install]
WantedBy=default.target
